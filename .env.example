# IBVAP 2.0 - Configuration
# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./ibvap.db

# Ingestion Configuration
DEFAULT_TARGET_FPS=25.0
DEFAULT_FRAME_WIDTH=1280
DEFAULT_FRAME_HEIGHT=720
RECONNECT_INTERVAL_SECONDS=3.0
MAX_RECONNECT_ATTEMPTS=10

# Health Monitoring Thresholds
FROZEN_FRAME_THRESHOLD_SECONDS=5.0
FROZEN_DIFF_THRESHOLD=0.8
BLACK_FRAME_MEAN_THRESHOLD=5.0
BLACK_FRAME_STD_THRESHOLD=2.0

# RTSP Defaults (Used if credentials not provided per-camera)
RTSP_USERNAME=
RTSP_PASSWORD=
